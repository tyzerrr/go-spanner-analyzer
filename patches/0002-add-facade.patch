+#include <string>
+#include <vector>
+
+#include "backend/schema/facade/types.h"
+
+namespace spanner_analyzer {
+
+// Validates a whole set of DDL statements (GoogleSQL dialect) the way the
+// emulator does for CreateDatabase: statements are applied in order to an
+// empty schema and checked semantically (primary keys, interleaving,
+// indexes, foreign keys, ...). Stops at the first error, like the emulator.
+// Returns an empty vector when the DDL is valid.
+std::vector<ValidationError> ValidateDDL(const std::vector<std::string>& ddls);
