+// can expose a small, plain-typed API (std::string / std::vector / structs).
+#ifndef GO_SPANNER_ANALYZER_BACKEND_SCHEMA_FACADE_FACADE_H_
+#define GO_SPANNER_ANALYZER_BACKEND_SCHEMA_FACADE_FACADE_H_
+
+#include <string>
+#include <vector>
+
+#include "backend/schema/facade/syntax.h"  // re-export ParseDDL so one target exposes both
+#include "backend/schema/facade/types.h"
+
+namespace spanner_analyzer {
+
+// Validates a whole set of DDL statements (GoogleSQL dialect) the way the
+// emulator does for CreateDatabase: statements are applied in order to an
+// empty schema and checked semantically (primary keys, interleaving,
+// indexes, foreign keys, ...). Stops at the first error, like the emulator.
+// Returns an empty vector when the DDL is valid.
+std::vector<ValidationError> ValidateDDL(const std::vector<std::string>& ddls);
+
+// Analyzes one query or DML statement (GoogleSQL dialect) against the schema
+// the DDL statements describe, the way the emulator does before executing
+// it: names are resolved against that schema's tables, columns, indexes and
+// functions, and the statement is type checked. Returns an empty vector when
+// the statement is valid.
+//
+// If the DDL itself does not build, that error is returned and the statement
+// is not looked at. An error in the statement carries its 1-based line and
+// column within `sql`; statement_index is always -1.
+std::vector<ValidationError> AnalyzeQuery(const std::vector<std::string>& ddls,
+                                          const std::string& sql);
+
+}  // namespace spanner_analyzer
+
+#endif  // GO_SPANNER_ANALYZER_BACKEND_SCHEMA_FACADE_FACADE_H_
