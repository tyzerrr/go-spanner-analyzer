+# (same path as the emulator's CreateDatabase / UpdateDatabaseDdl), and
+# analyzes a query against it with the emulator's own catalog (same path as
+# its ExecuteSql before evaluation).
+cc_library(
+    name = "facade",
+    srcs = ["facade.cc"],
+    hdrs = ["facade.h"],
+    deps = [
