+        "@com_google_googleapis//google/spanner/admin/database/v1:database_cc_proto",
+        "@com_google_googlesql//googlesql/public:analyzer",
+        "@com_google_googlesql//googlesql/public:analyzer_options",
+        "@com_google_googlesql//googlesql/public:analyzer_output",
+        "@com_google_googlesql//googlesql/public:error_helpers",
+        "@com_google_googlesql//googlesql/public:error_location_cc_proto",
+        "@com_google_googlesql//googlesql/public:type",
+    ],
+)
diff --git a/backend/schema/facade/facade.cc b/backend/schema/facade/facade.cc
new file mode 100644
index 0000000..abefea9
--- /dev/null
+++ b/backend/schema/facade/facade.cc
@@ -0,0 +1,143 @@
+// Copyright 2026 Taichi Araki (go-spanner-analyzer)
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+//
+// ADDED by go-spanner-analyzer: thin facade over the emulator so that wasmify
+// can expose a small, plain-typed API (std::string / std::vector / structs).
+#include "backend/schema/facade/facade.h"
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "google/spanner/admin/database/v1/common.pb.h"
+#include "googlesql/public/analyzer.h"
+#include "googlesql/public/analyzer_options.h"
+#include "googlesql/public/analyzer_output.h"
+#include "googlesql/public/error_helpers.h"
+#include "googlesql/public/error_location.pb.h"
+#include "googlesql/public/type.h"
+#include "absl/status/status.h"
+#include "absl/status/statusor.h"
+#include "absl/types/span.h"
+#include "backend/common/ids.h"
+#include "backend/database/pg_oid_assigner/pg_oid_assigner.h"
+#include "backend/query/analyzer_options.h"
+#include "backend/query/catalog.h"
+#include "backend/query/function_catalog.h"
+#include "backend/schema/catalog/schema.h"
+#include "backend/schema/updater/schema_updater.h"
+
+namespace spanner_analyzer {
+
+namespace backend = ::google::spanner::emulator::backend;
+namespace database_api = ::google::spanner::admin::database::v1;
+
+namespace {
+
+// Everything a built schema keeps pointers into. The schema borrows the type
+// factory and the ID generators, so they live here next to it and go away
+// together.
+struct BuiltSchema {
+  googlesql::TypeFactory type_factory;
+  backend::TableIDGenerator table_id_gen;
+  backend::ColumnIDGenerator column_id_gen;
+  backend::PgOidAssigner pg_oid_assigner{/*enabled=*/false};
+  std::unique_ptr<const backend::Schema> schema;
+  absl::Status status;
+};
+
+// Mirrors tests/common/schema_constructor.cc: a fresh type factory and ID
+// generators per call; no storage (validation only, no backfills).
+void BuildSchema(const std::vector<std::string>& ddls, BuiltSchema* out) {
+  backend::SchemaChangeContext context{
+      .type_factory = &out->type_factory,
+      .table_id_generator = &out->table_id_gen,
+      .column_id_generator = &out->column_id_gen,
+      .pg_oid_assigner = &out->pg_oid_assigner,
+      .database_id = "go-spanner-analyzer",
+  };
+  backend::SchemaUpdater updater;
+  absl::StatusOr<std::unique_ptr<const backend::Schema>> result =
+      updater.ValidateSchemaFromDDL(
+          backend::SchemaChangeOperation{
+              .statements = absl::MakeConstSpan(ddls),
+              .proto_descriptor_bytes = "",
+              .database_dialect = database_api::GOOGLE_STANDARD_SQL},
+          context);
+  if (!result.ok()) {
+    out->status = result.status();
+    return;
+  }
+  out->schema = std::move(*result);
+}
+
+}  // namespace
+
+std::vector<ValidationError> ValidateDDL(const std::vector<std::string>& ddls) {
+  BuiltSchema built;
+  BuildSchema(ddls, &built);
+  std::vector<ValidationError> errors;
+  if (!built.status.ok()) {
+    // The emulator reports one error and stops; we do not know which
+    // statement caused it, so statement_index is -1.
+    errors.push_back(internal::MakeError(built.status.message(), -1));
+  }
+  return errors;
+}
+
+// Mirrors backend/query/catalog_test.cc: the emulator's own catalog over the
+// built schema, handed to the GoogleSQL analyzer.
+std::vector<ValidationError> AnalyzeQuery(const std::vector<std::string>& ddls,
+                                          const std::string& sql) {
+  std::vector<ValidationError> errors;
+
+  BuiltSchema built;
+  BuildSchema(ddls, &built);
+  if (!built.status.ok()) {
+    errors.push_back(internal::MakeError(built.status.message(), -1));
+    return errors;
+  }
+
+  backend::FunctionCatalog function_catalog(
+      &built.type_factory, backend::kCloudSpannerEmulatorFunctionCatalogName,
+      built.schema.get());
+  function_catalog.SetLatestSchema(built.schema.get());
+
+  // The time zone only affects how timestamp literals evaluate, which
+  // analysis never does; UTC keeps the result independent of the machine.
+  googlesql::AnalyzerOptions options =
+      backend::MakeGoogleSqlAnalyzerOptions("UTC");
+  // Keep the location out of the message text and in the payload instead, so
+  // the caller gets a line and a column rather than " [at 1:8]" to parse.
+  options.set_error_message_mode(
+      googlesql::AnalyzerOptions::ERROR_MESSAGE_WITH_PAYLOAD);
+
+  backend::Catalog catalog(built.schema.get(), &function_catalog,
+                           &built.type_factory, options);
+  std::unique_ptr<const googlesql::AnalyzerOutput> output;
+  absl::Status status = googlesql::AnalyzeStatement(
+      sql, options, &catalog, &built.type_factory, &output);
+  if (!status.ok()) {
+    ValidationError error = internal::MakeError(status.message(), -1);
+    googlesql::ErrorLocation location;
+    if (googlesql::GetErrorLocation(status, &location)) {
+      error.line = location.line();
+      error.column = location.column();
+    }
+    errors.push_back(error);
+  }
+  return errors;
+}
+
+}  // namespace spanner_analyzer
