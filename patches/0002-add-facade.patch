+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+//
+// ADDED by go-spanner-analyzer: thin facade over the emulator so that wasmify
+// can expose a small, plain-typed API (std::string / std::vector / structs).
+#include "backend/schema/facade/syntax.h"
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "absl/status/status.h"
+#include "backend/schema/ddl/operations.pb.h"
+#include "backend/schema/parser/ddl_parser.h"
+
+namespace spanner_analyzer {
+
+std::vector<ValidationError> ParseDDL(const std::vector<std::string>& ddls) {
+  namespace ddl = ::google::spanner::emulator::backend::ddl;
+  std::vector<ValidationError> errors;
+  for (size_t i = 0; i < ddls.size(); ++i) {
+    ddl::DDLStatement statement;
+    absl::Status status = ddl::ParseDDLStatement(ddls[i], &statement);
+    if (!status.ok()) {
+      errors.push_back(
+          internal::MakeError(status.message(), static_cast<int32_t>(i)));
+    }
+  }
+  return errors;
+}
+
+}  // namespace spanner_analyzer
