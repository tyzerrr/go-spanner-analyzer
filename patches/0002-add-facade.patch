+//
+// ADDED by go-spanner-analyzer: thin facade over the emulator so that wasmify
+// can expose a small, plain-typed API (std::string / std::vector / structs).
+#ifndef GO_SPANNER_ANALYZER_BACKEND_SCHEMA_FACADE_TYPES_H_
+#define GO_SPANNER_ANALYZER_BACKEND_SCHEMA_FACADE_TYPES_H_
+
+#include <cstdint>
+#include <string>
+
+#include "absl/strings/string_view.h"
+
+namespace spanner_analyzer {
+
+// One problem found in a DDL statement.
+struct ValidationError {
+  // Human readable message as produced by the emulator.
+  std::string message;
+  // 1-based line within the statement. 0 when the emulator did not report a
+  // position (all semantic errors, some syntax errors).
+  int32_t line;
+  // 1-based column within the statement. 0 when unknown.
+  int32_t column;
+  // 0-based index of the statement in the input that caused the error.
+  int32_t statement_index;
+};
+
+namespace internal {
+
+// Builds a ValidationError from an emulator error message, extracting
+// "Syntax error on line N, column M" / "line N column M" when present.
+inline ValidationError MakeError(absl::string_view message,
+                                 int32_t statement_index) {
+  ValidationError e;
+  e.message = std::string(message);
+  e.line = 0;
+  e.column = 0;
+  e.statement_index = statement_index;
+  auto read_int = [](absl::string_view s, size_t pos) -> int32_t {
+    int32_t v = 0;
+    bool any = false;
+    while (pos < s.size() && s[pos] >= '0' && s[pos] <= '9') {
+      v = v * 10 + (s[pos] - '0');
+      ++pos;
+      any = true;
+    }
+    return any ? v : 0;
+  };
+  size_t l = message.find("on line ");
+  if (l != absl::string_view::npos) {
+    e.line = read_int(message, l + 8);
+    size_t c = message.find("column ", l);
+    if (c != absl::string_view::npos) e.column = read_int(message, c + 7);
+  }
+  return e;
+}
+
+}  // namespace internal
+}  // namespace spanner_analyzer
+
+#endif  // GO_SPANNER_ANALYZER_BACKEND_SCHEMA_FACADE_TYPES_H_
